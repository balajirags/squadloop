{
  "name": "squadloop",
  "version": "1.0.1",
  "description": "SquadLoop — Your autonomous software team (BA, Dev, QA, Reviewer in tmux)",
  "main": "dist/index.js",
  "bin": {
    "squadloop": "./bin/squadloop.js"
  },
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc && cp -r dist/.squadloop/extensions/* .squadloop/extensions/ && npx esbuild .squadloop/extensions/workflow/workflow-fsm.ts --bundle --platform=node --format=esm --outfile=.squadloop/extensions/workflow/workflow-fsm.js --external:@earendil-works/pi-coding-agent",
    "prepublishOnly": "npm run build",
    "release:patch": "npm run build && npm version patch && git push origin main --tags && npm publish",
    "release:minor": "npm run build && npm version minor && git push origin main --tags && npm publish",
    "release:major": "npm run build && npm version major && git push origin main --tags && npm publish"
  },
  "pi": {
    "extensions": [
      "./.squadloop/extensions"
    ],
    "skills": [
      "./.squadloop/skills"
    ],
    "prompts": [
      "./.squadloop/prompts"
    ]
  },
  "bundledDependencies": [
    "pi-subagents",
    "pi-web-access"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@sinclair/typebox": "0.34.0",
    "pi-subagents": "0.56.0",
    "pi-web-access": "0.25.0",
    "xstate": "^5.32.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "bundleDependencies": [
    "pi-subagents",
    "pi-web-access"
  ]
}
